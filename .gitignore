# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
.terraform.lock.hcl

# Secrets / credentials
android/key.properties
*.keystore
*.jks
.env
.env.*

# Local dev environment (Stripe sandbox testing) — venv/binaries only, scripts are tracked
dev/venv/
dev/bin/

# Sensitive debug output (contains real member PII captured during testing)
response.json
iac/response.json
src/response.json

# Lambda build artifacts — vendored deps and zipped packages are rebuilt on
# deploy, not source we maintain. Keeping them out avoids huge, stale diffs.
lambda/*.zip
lambda/deployed_handler.zip
lambda/bin/
lambda/certifi/
lambda/certifi-*.dist-info/
lambda/charset_normalizer/
lambda/charset_normalizer-*.dist-info/
lambda/idna/
lambda/idna-*.dist-info/
lambda/requests/
lambda/requests-*.dist-info/
lambda/stripe/
lambda/stripe-*.dist-info/
lambda/typing_extensions.py
lambda/typing_extensions-*.dist-info/
lambda/urllib3/
lambda/urllib3-*.dist-info/
lambda/*.so
lambda/package/
__pycache__/
*.pyc

# src/ vendored Python deps (installed locally for running one-off scripts;
# rebuilt via requirements, not source we maintain)
src/bin/
src/*.dist-info/
src/annotated_types/
src/anthropic/
src/anyio/
src/certifi/
src/distro/
src/docstring_parser/
src/h11/
src/httpcore/
src/httpx/
src/idna/
src/jiter/
src/pydantic/
src/pydantic_core/
src/sniffio/
src/typing_extensions.py
src/typing_inspection/

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
